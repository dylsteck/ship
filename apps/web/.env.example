# GitHub OAuth
# Create OAuth App: https://github.com/settings/developers
# Application name: Ship (or your preferred name)
# Homepage URL: http://localhost:3000 (dev) or your production URL
# Authorization callback URL: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Local-only sentinel: setting GITHUB_CLIENT_ID=emulate (and only when
# NODE_ENV !== 'production') routes all GitHub OAuth + REST traffic to the
# in-app emulator at /emulate/github so an agent can sign in autonomously.
# See .agents/skills/emulate-login/SKILL.md.

# Session Encryption
# Generate with: openssl rand -hex 32
# Must be at least 32 characters for secure encryption
SESSION_SECRET=your-32-char-secret-key-here-min

# API Configuration
# Local dev: leave unset to use the wrangler default (http://localhost:8787)
# Preview/dev: point to the deployed dev Worker URL
# Production: point to the deployed production Worker URL
# Login restriction (LOGIN_RESTRICTED_TO_SINGLE_USER, ALLOWED_USER_ID) is API-only; see apps/api/.dev.vars.example
API_BASE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal API auth (required) - must match API_SECRET in apps/api/.dev.vars
# Generate with: openssl rand -hex 32
API_SECRET=
