{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "predev": "node ./scripts/bundle-acp-bridge.mjs",
    "deploy": "wrangler deploy",
    "predeploy": "node ./scripts/bundle-acp-bridge.mjs",
    "deploy:prod": "wrangler deploy --env production",
    "predeploy:prod": "node ./scripts/bundle-acp-bridge.mjs",
    "bundle:acp-bridge": "node ./scripts/bundle-acp-bridge.mjs",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "openapi:check": "pnpm openapi:export && git diff --exit-code openapi/ship-api.openapi.json",
    "pretypecheck": "node ./scripts/bundle-acp-bridge.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@computesdk/e2b": "^1.7.75",
    "@effect/platform": "^0.96.3",
    "@octokit/rest": "^22.0.1",
    "@ship/contracts": "workspace:*",
    "@ship/sandbox": "workspace:*",
    "@ship/types": "workspace:*",
    "e2b": "^2.64.0",
    "effect": "^3.22.4",
    "hono": "^4.13.19",
    "jose": "^6.2.18",
    "octokit-plugin-create-pull-request": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.165.0"
  }
}
