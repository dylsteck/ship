{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "predev": "node ./scripts/bundle-acp-bridge.mjs",
    "deploy": "wrangler deploy",
    "predeploy": "node ./scripts/bundle-acp-bridge.mjs",
    "deploy:prod": "wrangler deploy --env production",
    "predeploy:prod": "node ./scripts/bundle-acp-bridge.mjs",
    "bundle:acp-bridge": "node ./scripts/bundle-acp-bridge.mjs",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "openapi:check": "pnpm openapi:export && git diff --exit-code openapi/ship-api.openapi.json",
    "pretypecheck": "node ./scripts/bundle-acp-bridge.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@e2b/code-interpreter": "^2.3.3",
    "@octokit/rest": "^22.0.1",
    "@ship/contracts": "workspace:*",
    "@ship/sandbox": "workspace:*",
    "@ship/types": "workspace:*",
    "hono": "^4.12.18",
    "jose": "^6.1.3",
    "octokit-plugin-create-pull-request": "^6.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.0.0",
    "wrangler": "^4.76.0"
  }
}
