{
  "name": "ship",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "deploy": "cd apps/api && pnpm run deploy",
    "deploy:prod": "cd apps/api && pnpm run deploy:prod",
    "deploy:web": "pnpm --filter web run deploy",
    "openapi:export": "pnpm --filter api openapi:export",
    "openapi:check": "pnpm --filter api openapi:check",
    "sdk:generate": "pnpm --filter @ship/sdk generate",
    "sdk:generate:check": "pnpm --filter @ship/sdk generate:check"
  },
  "devDependencies": {
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
